{
  "name": "merez-ui",
  "version": "0.2.0",
  "description": "Merez shared design system — framework-agnostic CSS core (tokens, components, fonts) plus an optional Tailwind adapter, consumed by every Merez frontend and used as the base for client sites.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "files": [
    "tokens.css",
    "fonts.css",
    "components.css",
    "merez.css",
    "brand-template.css",
    "tailwind-preset.js",
    "tailwind-preset.d.ts",
    "logo/merez-mark.svg",
    "logo/merez-favicon.svg"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./components.css": "./components.css",
    "./merez.css": "./merez.css",
    "./brand-template.css": "./brand-template.css",
    "./logo/merez-mark.svg": "./logo/merez-mark.svg",
    "./logo/merez-favicon.svg": "./logo/merez-favicon.svg",
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.ts",
      "default": "./tailwind-preset.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:palette": "node scripts/build-palette.mjs",
    "check": "node scripts/build-palette.mjs --check && node scripts/check-contrast.mjs"
  }
}
